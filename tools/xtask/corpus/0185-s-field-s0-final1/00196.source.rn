// Record 0133, U1: semantic search over rnx's own records (D1).
// args: D1 directory, model directory, rubric.tsv

// ---- the frozen chunking rule (no split_whitespace or Vec::join: F1, F2) ----

fn words(s) {
    let out = [];
    for w in s.replace("\n", " ").replace("\t", " ").replace("\r", " ").split(" ") {
        if w != "" { out.push(w); }
    }
    out
}

fn joined(ws, from, to) {
    let s = "";
    for i in from..to {
        if i > from { s += " "; }
        s += ws[i];
    }
    s
}

pub fn chunks(body) {
    let out = [];
    let cur = [];
    for para in body.split("\n\n") {
        let ws = words(para);
        if ws.len() == 0 { continue; }
        if ws.len() > 180 {
            if cur.len() > 0 { out.push(joined(cur, 0, cur.len())); cur = []; }
            let i = 0;
            while i < ws.len() {
                let j = i + 180;
                if j > ws.len() { j = ws.len(); }
                out.push(joined(ws, i, j));
                i = j;
            }
            continue;
        }
        if cur.len() + ws.len() > 180 { out.push(joined(cur, 0, cur.len())); cur = []; }
        for w in ws { cur.push(w); }
    }
    if cur.len() > 0 { out.push(joined(cur, 0, cur.len())); }
    out
}

// ---- frames ----

fn column_str(name, values) {
    Ok(polars::Series::from_iter_str(values)?.with_name(name).into_column())
}

fn column_i64(name, values) {
    Ok(polars::Series::from_iter_i64(values)?.with_name(name).into_column())
}

/// D1 as two frames: documents (doc, path, record, title) and passages
/// (doc, text) by the frozen chunking rule.
pub fn load(dir) {
    let doc = [];
    let paths = [];
    let records = [];
    let titles = [];
    let pdoc = [];
    let ptext = [];
    for n in fs::read_dir(dir)? {
        if !n.ends_with(".md") { continue; }
        let text = fs::read(`${dir}/${n}`)?;
        let first = text.split("\n").next().unwrap_or("");
        let title = if first.starts_with("# ") { first[2..] } else { first };
        let d = paths.len();
        doc.push(d);
        paths.push(n);
        records.push(n[0..4]);
        titles.push(title);
        for c in chunks(text[first.len()..]) {
            pdoc.push(d);
            ptext.push(c);
        }
    }
    let docs = polars::DataFrame::new(paths.len(), [
        column_i64("doc", doc)?,
        column_str("path", paths)?,
        column_str("record", records)?,
        column_str("title", titles)?,
    ])?;
    let passages = polars::DataFrame::new(ptext.len(), [column_i64("doc", pdoc)?, column_str("text", ptext)?])?;
    Ok((docs, passages, ptext))
}


// ---- U2: near-duplicate detection ----

/// The ticket inputs (D2): title, a newline, the first 180 words of the body.
pub fn tickets(path) {
    let issues = json::parse(fs::read(path)?)?;
    let numbers = [];
    let titles = [];
    let texts = [];
    for i in issues {
        let ws = words(i["body"]);
        let n = ws.len();
        if n > 180 { n = 180; }
        numbers.push(i["number"]);
        titles.push(i["title"]);
        texts.push(i["title"] + "\n" + joined(ws, 0, n));
    }
    Ok((numbers, titles, texts))
}

/// All pairs i < j with a score in [lo, hi), from an n x n similarity frame
/// (an `id` column, then s0 ... s{n-1}), read back through Polars: a mask per
/// column, then the matching rows cast to strings and parsed (Dense is
/// opaque to scripts; Polars has no numeric readback into Rune).
pub fn band(frame, n, lo, hi) {
    let out = [];
    for j in 0..n {
        let name = `s${j}`;
        let lo_col = polars::Series::from_iter_f32([lo])?.into_column();
        let hi_col = polars::Series::from_iter_f32([hi])?.into_column();
        // no AND of two boolean masks in the shipped bindings (F16): filter twice
        let low = frame.filter(frame.column(name)?.gt_eq(lo_col)?)?;
        let rows = low.filter(low.column(name)?.lt(hi_col)?)?;
        if rows.height()? == 0 { continue; }
        let text = rows.lazy().select_([
            polars::col("id").cast(polars::DataType::String()),
            polars::col(name).cast(polars::DataType::String()),
        ])?.collect()?;
        let ids = text.strings("id")?;
        let scores = text.strings(name)?;
        for k in 0..ids.len() {
            let i = ids[k].parse::<i64>()?;
            if i < j { out.push((i, j, scores[k].parse::<f64>()?)); }
        }
    }
    Ok(out)
}

/// The pairs, sorted by score, printed with both titles.
pub fn show(label, pairs, titles, limit) {
    pairs.sort_by(|a, b| b.2.partial_cmp(a.2).unwrap());
    println!("{}: {} pairs", label, pairs.len());
    let k = 0;
    for p in pairs {
        if k == limit { break; }
        println!("  {}  {}  |  {}", p.2, titles[p.0], titles[p.1]);
        k += 1;
    }
}

/// The similarity frame of `block` with itself: an `id` column and one
/// column per row.
pub fn all_pairs(block, n) {
    let names = [];
    let ids = [];
    for i in 0..n {
        names.push(`s${i}`);
        ids.push(i);
    }
    let s = candle::similarity(block, block, names)?;
    let ids = polars::Series::from_iter_i64(ids)?.with_name("id").into_column();
    Ok(polars::DataFrame::new(n, [ids])?.with_dense(s)?)
}


// ---- U3: grouping similar support tickets (D2) ----

/// The ticket labels, joined (no Vec::join: F2).
fn labels_of(issue) {
    let s = "";
    let first = true;
    for l in issue["labels"] {
        if !first { s += ","; }
        s += l;
        first = false;
    }
    s
}

/// Union-find with path halving.
fn find(parent, i) {
    while parent[i] != i {
        parent[i] = parent[parent[i]];
        i = parent[i];
    }
    i
}

pub fn run(args) {
    let d2 = args[0];
    let model = args[1];
    let out = args[2];
    let t0 = time::monotonic_ms();
    let enc = candle::TextEncoder::load(model)?;
    let issues = json::parse(fs::read(d2)?)?;
    let (numbers, titles, texts) = tickets(d2)?;
    let n = numbers.len();
    let e = enc.embed(texts)?;
    let frame = all_pairs(e, n)?;
    let edges = band(frame, n, 0.80, 2.0)?;
    // connected components over the edges at or above 0.80
    let parent = [];
    for i in 0..n { parent.push(i); }
    for p in edges {
        let a = find(parent, p.0);
        let b = find(parent, p.1);
        if a != b { parent[a] = b; }
    }
    let members = [];
    for i in 0..n { members.push([]); }
    for i in 0..n { members[find(parent, i)].push(i); }
    let groups = [];
    for g in members { if g.len() > 0 { groups.push(g); } }
    groups.sort_by(|a, b| b.len().cmp(a.len()));
    let singletons = 0;
    for g in groups { if g.len() == 1 { singletons += 1; } }
    println!("{} tickets, {} edges at >= 0.80, {} groups; largest {}; singletons {} ({}%)", n, edges.len(), groups.len(), groups[0].len(), singletons, singletons * 100 / n);
    let shown = 0;
    for g in groups {
        if shown == 10 || g.len() < 2 { break; }
        println!("group {} ({} tickets):", shown + 1, g.len());
        let k = 0;
        for i in g {
            if k == 8 { println!("    …"); break; }
            println!("    #{} [{}] {}", numbers[i], labels_of(issues[i]), titles[i]);
            k += 1;
        }
        shown += 1;
    }
    println!("time: {} ms", time::monotonic_ms() - t0);
    // every ticket's component, singletons included, named by its smallest
    // issue number; and every edge
    let rows = "issue\tcomponent\n";
    for g in groups {
        let least = numbers[g[0]];
        for i in g { if numbers[i] < least { least = numbers[i]; } }
        for i in g { rows += `#${numbers[i]}\t#${least}\n`; }
    }
    for p in edges { rows += `edge\t#${numbers[p.0]}\t#${numbers[p.1]}\t${p.2}\n`; }
    fs::write(`${out}/u3.tsv`, rows)?;
    println!("WORKFLOW OK u3");
    Ok(())
}
