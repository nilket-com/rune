// Record 0144: 0143's E6 with its original two-line println! restored (0143
// had to join it onto one line to paste in a session). Otherwise byte for byte.
// Record 0143, E6: topic discovery over the project's 252 support tickets
// (0133's D2), frozen in plans/0143 before any run. Each whole ticket is
// chunked (0136), embedded and pooled (0137), then grouped by spherical
// k-means with k = 6: farthest-point initialization (no randomness), the
// frozen donor rule for empty clusters, at most 50 iterations. Each cluster
// is shown with its size, a SUGGESTED name (the nearest of 0139's label
// descriptions, a suggestion, not a classification) and its three most
// central tickets. The vectors go to NumPy through write_npz.
// args: D2 issues.json, model directory, 0139's labels.tsv, output directory
// or: "--synthetic", a JSON file {"k": k, "rows": [[...], ...]}, output file

/// Rows scaled to unit length; a zero or non-finite norm is refused.
fn unit_rows(x, what) {
    let norms = x.sqr()?.sum_keepdim(1)?.sqrt()?;
    for row in norms.to_vec2()? {
        let z = row[0];
        // NaN fails z > 0.0; an infinity fails z - z == 0.0
        if !(z > 0.0 && z - z == 0.0) {
            return Err(`${what} has norm ${z}; it cannot be normalized`);
        }
    }
    Ok(x.broadcast_div(norms)?)
}

fn ids(v) { candle::Tensor::from_vec(v, [v.len()], "u32") }

/// Spherical k-means, the frozen rule. Returns the trace and the result.
fn kmeans(u, k) {
    let n = u.dims()[0];
    // the ticket most similar to the normalized mean, then repeatedly the
    // ticket least similar to every chosen one; ties to the lowest index
    let g = unit_rows(u.mean_keepdim(0)?, "the mean")?;
    let chosen = [u.matmul(g.t()?)?.argmax(0)?.to_vec1()?[0]];
    while chosen.len() < k {
        let c = u.index_select(ids(chosen)?, 0)?;
        chosen.push(u.matmul(c.t()?)?.max(1)?.argmin(0)?.to_scalar()?);
    }
    let centroids = u.index_select(ids(chosen)?, 0)?;
    let prev = None;
    let moves = [];
    let history = [];
    let it = 0;
    let converged = false;
    let a = [];
    let s = [];
    while it < 50 {
        it += 1;
        let st = u.matmul(centroids.t()?)?;
        s = st.to_vec2()?;
        // highest similarity; ties to the lowest centroid (Candle's argmax)
        a = st.argmax(1)?.to_vec1()?;
        let sizes = [];
        for _ in 0..k { sizes.push(0); }
        for x in a { sizes[x] = sizes[x] + 1; }
        // each empty cluster, in order, takes the ticket least similar to
        // its own cluster's centroid, among clusters of two or more members
        for c in 0..k {
            if sizes[c] == 0 {
                let donor = None;
                for i in 0..n {
                    if sizes[a[i]] >= 2 {
                        donor = match donor {
                            None => Some(i),
                            Some(d) => if s[i][a[i]] < s[d][a[d]] { Some(i) } else { Some(d) },
                        };
                    }
                }
                let d = donor.unwrap();
                sizes[a[d]] = sizes[a[d]] - 1;
                a[d] = c;
                sizes[c] = 1;
                moves.push((it, c, d));
            }
        }
        // review round 1: every iteration's assignments, after the moves
        history.push(a.clone());
        if let Some(p) = prev {
            if p == a { converged = true; break; }
        }
        centroids = unit_rows(candle::segment_mean(u, ids(a)?, k)?, "a centroid")?;
        prev = Some(a.clone());
    }
    Ok(#{ chosen, moves, history, it, converged, a, s, centroids })
}

/// The trace as text, exactly as the twin prints it.
fn trace(r) {
    let out = "init\t";
    let first = true;
    for c in r.chosen { if !first { out += ","; } out += `${c}`; first = false; }
    out += "\n";
    for m in r.moves { out += `move\t${m.0}\t${m.1}\t${m.2}\n`; }
    let k = 1;
    for h in r.history {
        out += `iter\t${k}\t`;
        let first = true;
        for x in h { if !first { out += ","; } out += `${x}`; first = false; }
        out += "\n";
        k += 1;
    }
    out += `iterations\t${r.it}\t${r.converged}\n`;
    let i = 0;
    for x in r.a { out += `assign\t${i}\t${x}\n`; i += 1; }
    let c = 0;
    for row in r.centroids.to_vec2()? {
        out += `centroid\t${c}\t`;
        let first = true;
        for x in row { if !first { out += ","; } out += `${x}`; first = false; }
        out += "\n";
        c += 1;
    }
    Ok(out)
}

fn synthetic(args) {
    let spec = json::parse(fs::read(args[1])?)?;
    let rows = spec["rows"];
    let flat = [];
    for r in rows { for x in r { flat.push(x); } }
    let x = candle::Tensor::from_vec(flat, [rows.len(), rows[0].len()], "f32")?;
    let r = kmeans(unit_rows(x, "a row")?, spec["k"])?;
    fs::write(args[2], trace(r)?)?;
    println!("WORKFLOW OK e6 synthetic");
    Ok(())
}

/// The three most similar members of cluster c; ties to the lowest index.
fn central(r, c) {
    let picked = [];
    while picked.len() < 3 {
        let best = None;
        for i in 0..r.a.len() {
            if r.a[i] == c && !picked.iter().any(|q| q == i) {
                best = match best {
                    None => Some(i),
                    Some(b) => if r.s[i][c] > r.s[b][c] { Some(i) } else { Some(b) },
                };
            }
        }
        match best { None => break, Some(b) => picked.push(b) }
    }
    picked
}

pub fn run(args) {
    if args[0] == "--synthetic" { return synthetic(args); }
    let issues = json::parse(fs::read(args[0])?)?;
    let enc = candle::TextEncoder::load(args[1])?;
    let names = [];
    let descriptions = [];
    for line in fs::read(args[2])?.split("\n").skip(1) {
        if line == "" { continue; }
        let f = line.split("\t").collect::<Vec>();
        names.push(f[0]);
        descriptions.push(f[1]);
    }
    let numbers = [];
    let titles = [];
    let passages = [];
    let owner = [];
    let t = 0;
    for i in issues {
        numbers.push(i["number"]);
        titles.push(i["title"]);
        for p in enc.chunk(i["title"] + "\n" + i["body"], 0)? {
            passages.push(p);
            owner.push(t);
        }
        t += 1;
    }
    let n = numbers.len();
    let t0 = time::monotonic_ms();
    let emb = candle::Tensor::from_dense(enc.embed(passages)?)?;
    let u = unit_rows(candle::segment_mean(emb, ids(owner)?, n)?, "a ticket")?;
    let labels = unit_rows(candle::Tensor::from_dense(enc.embed(descriptions)?)?, "a label")?;
    let t1 = time::monotonic_ms();
    let r = kmeans(u, 6)?;
    let t2 = time::monotonic_ms();

    // sizes by index_add; suggested names by centroid-label similarity
    let sizes = candle::Tensor::zeros([6], "f32")?
        .index_add(ids(r.a)?, candle::Tensor::ones([n], "f32")?, 0)?
        .to_vec1()?;
    let ls = r.centroids.matmul(labels.t()?)?;
    let best = ls.argmax(1)?.to_vec1()?;
    let lsv = ls.to_vec2()?;
    let col_cluster = [];
    let col_size = [];
    let col_name = [];
    let col_sim = [];
    let col_central = [];
    let table = "cluster\tsize\tsuggested\tsimilarity\tcentral\n";
    for c in 0..6 {
        let picks = central(r, c);
        let text = "";
        let nums = "";
        for p in picks {
            if text != "" { text += " | "; nums += ","; }
            text += `#${numbers[p]} ${titles[p]}`;
            nums += `${numbers[p]}`;
        }
        col_cluster.push(c);
        col_size.push(sizes[c] as i64);
        col_name.push(names[best[c]]);
        col_sim.push(lsv[c][best[c]]);
        col_central.push(text);
        table += `${c}\t${sizes[c]}\t${names[best[c]]}\t${lsv[c][best[c]]}\t${nums}\n`;
    }
    let df = polars::DataFrame::new(6, [
        polars::Series::from_iter_i64(col_cluster)?.with_name("cluster").into_column(),
        polars::Series::from_iter_i64(col_size)?.with_name("size").into_column(),
        polars::Series::from_iter_str(col_name)?.with_name("suggested").into_column(),
        polars::Series::from_iter_f64(col_sim)?.with_name("similarity").into_column(),
        polars::Series::from_iter_str(col_central)?.with_name("most central tickets").into_column(),
    ])?;
    println!("{}", df.preview()?);

    // to NumPy: one archive, and the centroids alone; then read back
    let dir = args[3];
    let assignments = ids(r.a)?;
    candle::Tensor::write_npz([("embeddings", u), ("centroids", r.centroids), ("assignments", assignments)], dir + "/e6.npz")?;
    r.centroids.write_npy(dir + "/centroids.npy")?;
    let back = candle::Tensor::read_npz(dir + "/e6.npz")?;
    let exact = back.len() == 3
        && back[0].1.write_bytes()? == u.write_bytes()?
        && back[1].1.write_bytes()? == r.centroids.write_bytes()?
        && back[2].1.write_bytes()? == assignments.write_bytes()?
        && candle::Tensor::read_npy(dir + "/centroids.npy")?.write_bytes()? == r.centroids.write_bytes()?;
    let t3 = time::monotonic_ms();
    fs::write(dir + "/e6-trace.tsv", trace(r)?)?;
    fs::write(dir + "/e6-table.tsv", table)?;
    println!("{} tickets, {} passages; embed {} ms, k-means {} ms ({} iterations, converged {}, {} moves), export {} ms; read back exact: {}",
        n, passages.len(), t1 - t0, t2 - t1, r.it, r.converged, r.moves.len(), t3 - t2, exact);
    if !exact { return Err("the read-back differs"); }
    println!("WORKFLOW OK e6");
    Ok(())
}
