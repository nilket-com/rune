// Record 0134, E3: Polars and Candle together. 0133's U1 ranking, done on
// tensors: topk over the passage scores, the hits back into a Polars frame,
// joined to the document titles and displayed through 0124's preview.
// args: D1 directory, model directory, rubric.tsv, and optionally an output file

fn words(s) {
    let out = [];
    for w in s.replace("\n", " ").replace("\t", " ").replace("\r", " ").split(" ") {
        if w != "" { out.push(w); }
    }
    out
}

fn joined(ws, from, to) {
    let s = "";
    for i in from..to {
        if i > from { s += " "; }
        s += ws[i];
    }
    s
}

pub fn chunks(body) {
    let out = [];
    let cur = [];
    for para in body.split("\n\n") {
        let ws = words(para);
        if ws.len() == 0 { continue; }
        if ws.len() > 180 {
            if cur.len() > 0 { out.push(joined(cur, 0, cur.len())); cur = []; }
            let i = 0;
            while i < ws.len() {
                let j = i + 180;
                if j > ws.len() { j = ws.len(); }
                out.push(joined(ws, i, j));
                i = j;
            }
            continue;
        }
        if cur.len() + ws.len() > 180 { out.push(joined(cur, 0, cur.len())); cur = []; }
        for w in ws { cur.push(w); }
    }
    if cur.len() > 0 { out.push(joined(cur, 0, cur.len())); }
    out
}

// ---- frames ----

fn column_str(name, values) {
    Ok(polars::Series::from_iter_str(values)?.with_name(name).into_column())
}

fn column_i64(name, values) {
    Ok(polars::Series::from_iter_i64(values)?.with_name(name).into_column())
}

/// D1 as two frames: documents (doc, path, record, title) and passages
/// (doc, text) by the frozen chunking rule.
pub fn load(dir) {
    let doc = [];
    let paths = [];
    let records = [];
    let titles = [];
    let pdoc = [];
    let ptext = [];
    for n in fs::read_dir(dir)? {
        if !n.ends_with(".md") { continue; }
        let text = fs::read(`${dir}/${n}`)?;
        let first = text.split("\n").next().unwrap_or("");
        let title = if first.starts_with("# ") { first[2..] } else { first };
        let d = paths.len();
        doc.push(d);
        paths.push(n);
        records.push(n[0..4]);
        titles.push(title);
        for c in chunks(text[first.len()..]) {
            pdoc.push(d);
            ptext.push(c);
        }
    }
    let docs = polars::DataFrame::new(paths.len(), [
        column_i64("doc", doc)?,
        column_str("path", paths)?,
        column_str("record", records)?,
        column_str("title", titles)?,
    ])?;
    let passages = polars::DataFrame::new(ptext.len(), [column_i64("doc", pdoc)?, column_str("text", ptext)?])?;
    Ok((docs, passages, ptext))
}

/// The frozen rubric: the ids and texts of the queries.
pub fn rubric(path) {
    let ids = [];
    let texts = [];
    for line in fs::read(path)?.split("\n").skip(1) {
        if line == "" { continue; }
        let f = line.split("\t").collect::<Vec>();
        ids.push(f[0]);
        texts.push(f[2]);
    }
    Ok((ids, texts))
}

pub fn run(args) {
    let (docs, passages, ptext) = load(args[0])?;
    let (ids, texts) = rubric(args[2])?;
    let enc = candle::TextEncoder::load(args[1])?;
    let e = candle::Tensor::from_dense(enc.embed(ptext)?)?;
    let q = candle::Tensor::from_dense(enc.embed(texts)?)?;
    let (top, at) = q.matmul(e.t()?)?.topk(60, false)?;      // queries x 60
    let top = top.to_vec2()?;
    let at = at.to_vec2()?;
    let pdoc = passages.select_(["doc"])?.lazy().select_([polars::col("doc").cast(polars::DataType::String())])?.collect()?.strings("doc")?;
    let k = 0;
    let out = "";
    let paths = docs.strings("path")?;
    for id in ids {
        // the first five distinct documents among the top passages
        // no Vec::contains in Rune: a flag per document
        let seen = [];
        for _ in 0..docs.height()? { seen.push(false); }
        let doc = [];
        let score = [];
        let r = 0;
        while doc.len() < 5 && r < 60 {
            let d = pdoc[at[k][r]].parse::<i64>()?;
            if !seen[d] {
                seen[d] = true;
                doc.push(d);
                score.push(top[k][r]);
            }
            r += 1;
        }
        for w in 0..doc.len() { out += `${k}\t${paths[doc[w]]}\t${score[w]}\n`; }
        let hits = polars::DataFrame::new(doc.len(), [column_i64("doc", doc)?, polars::Series::from_iter_f64(score)?.with_name(id).into_column()])?;
        println!("{}: {}", id, texts[k]);
        println!("{}", hits.left_join(docs, ["doc"], ["doc"])?.select_(["record", "title", id])?);
        k += 1;
    }
    if args.len() > 3 { fs::write(args[3], out)?; }
    println!("WORKFLOW OK e3");
    Ok(())
}
