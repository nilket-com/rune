// Port of AWFY benchmarks/Lua/permute.lua.

const NAME = "Permute";

struct Permute {
	count,
	v,
}

impl Permute {
	fn inner_benchmark_loop(self, inner_iterations) {
		default_inner_benchmark_loop(self, inner_iterations)
	}

	fn benchmark(self) {
		self.count = 0;
		self.v = [0, 0, 0, 0, 0, 0];
		self.permute(6);
		self.count
	}

	fn verify_result(self, result) {
		8660 == result
	}

	fn permute(self, n) {
		self.count = self.count + 1;
		if n != 0 {
			let n1 = n - 1;
			self.permute(n1);
			let i = n1;
			while i >= 0 {
				self.swap(n1, i);
				self.permute(n1);
				self.swap(n1, i);
				i = i - 1;
			}
		}
	}

	fn swap(self, i, j) {
		let tmp = self.v[i];
		self.v[i] = self.v[j];
		self.v[j] = tmp;
	}
}

fn new_benchmark() {
	Permute { count: 0, v: [] }
}
