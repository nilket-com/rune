// Port of AWFY benchmarks/Lua/cd.lua.

const NAME = "CD";

const MIN_X = 0.0;
const MIN_Y = 0.0;
const MAX_X = 1000.0;
const MAX_Y = 1000.0;
const MIN_Z = 0.0;
const MAX_Z = 10.0;
const PROXIMITY_RADIUS = 1.0;
const GOOD_VOXEL_SIZE = PROXIMITY_RADIUS * 2.0;

struct Vector2D {
	x,
	y,
}

impl Vector2D {
	fn new(x, y) {
		Vector2D { x, y }
	}

	fn plus(self, other) {
		Vector2D::new(self.x + other.x, self.y + other.y)
	}

	fn minus(self, other) {
		Vector2D::new(self.x - other.x, self.y - other.y)
	}

	fn compare_to(self, other) {
		let result = compare_numbers(self.x, other.x);
		if result != 0 {
			result
		} else {
			compare_numbers(self.y, other.y)
		}
	}
}

fn compare_numbers(a, b) {
	if a == b {
		0
	} else if a < b {
		-1
	} else if a > b {
		1
	// We say that NaN is smaller than non-NaN.
	} else if a == a {
		1
	} else {
		-1
	}
}

struct Vector3D {
	x,
	y,
	z,
}

impl Vector3D {
	fn new(x, y, z) {
		Vector3D { x, y, z }
	}

	fn plus(self, other) {
		Vector3D::new(self.x + other.x, self.y + other.y, self.z + other.z)
	}

	fn minus(self, other) {
		Vector3D::new(self.x - other.x, self.y - other.y, self.z - other.z)
	}

	fn dot(self, other) {
		self.x * other.x + self.y * other.y + self.z * other.z
	}

	fn squared_magnitude(self) {
		self.dot(self)
	}

	fn magnitude(self) {
		self.squared_magnitude().sqrt()
	}

	fn times(self, amount) {
		Vector3D::new(self.x * amount, self.y * amount, self.z * amount)
	}
}

fn tree_minimum(x) {
	let current = x;
	while let Some(left) = current.left {
		current = left;
	}
	current
}

/// Whether the optional node `opt` is `node`, by identity.
fn is_node(node, opt) {
	if let Some(other) = opt {
		node.same(other)
	} else {
		false
	}
}

/// Identity of two optional nodes; two absent nodes are the same, as Lua's `nil == nil`.
fn same_node(a, b) {
	if let Some(a) = a {
		is_node(a, b)
	} else {
		b.is_none()
	}
}

enum Color {
	Red,
	Black,
}

/// A tree node. `id` is unique within its tree: Rune has no reference identity, and
/// structural `==` would recurse through the parent links.
struct Node {
	id,
	key,
	value,
	left,
	right,
	parent,
	color,
}

impl Node {
	fn new(id, key, value) {
		Node { id, key, value, left: None, right: None, parent: None, color: Color::Red }
	}

	fn same(self, other) {
		self.id == other.id
	}

	fn successor(self) {
		let x = self;
		if let Some(right) = x.right {
			return Some(tree_minimum(right));
		}

		let y = x.parent;
		while y.is_some() && is_node(x, y.unwrap().right) {
			x = y.unwrap();
			y = x.parent;
		}
		y
	}
}

struct RbtEntry {
	key,
	value,
}

impl RbtEntry {
	fn new(key, value) {
		RbtEntry { key, value }
	}
}

struct InsertResult {
	is_new_entry,
	new_node,
	old_value,
}

impl InsertResult {
	fn new(is_new_entry, new_node, old_value) {
		InsertResult { is_new_entry, new_node, old_value }
	}
}

struct RedBlackTree {
	root,
	next_id,
}

impl RedBlackTree {
	fn new() {
		RedBlackTree { root: None, next_id: 0 }
	}

	fn put(self, key, value) {
		let insertion_result = self.tree_insert(key, value);
		if !insertion_result.is_new_entry {
			return insertion_result.old_value;
		}

		let x = insertion_result.new_node.unwrap();

		while !is_node(x, self.root) && x.parent.unwrap().color == Color::Red {
			if is_node(x.parent.unwrap(), x.parent.unwrap().parent.unwrap().left) {
				let y = x.parent.unwrap().parent.unwrap().right;
				if y.is_some() && y.unwrap().color == Color::Red {
					// Case 1
					x.parent.unwrap().color = Color::Black;
					y.unwrap().color = Color::Black;
					x.parent.unwrap().parent.unwrap().color = Color::Red;
					x = x.parent.unwrap().parent.unwrap();
				} else {
					if is_node(x, x.parent.unwrap().right) {
						// Case 2
						x = x.parent.unwrap();
						self.left_rotate(x);
					}

					// Case 3
					x.parent.unwrap().color = Color::Black;
					x.parent.unwrap().parent.unwrap().color = Color::Red;
					self.right_rotate(x.parent.unwrap().parent.unwrap());
				}
			} else {
				// Same as "then" clause with "right" and "left" exchanged.
				let y = x.parent.unwrap().parent.unwrap().left;
				if y.is_some() && y.unwrap().color == Color::Red {
					// Case 1
					x.parent.unwrap().color = Color::Black;
					y.unwrap().color = Color::Black;
					x.parent.unwrap().parent.unwrap().color = Color::Red;
					x = x.parent.unwrap().parent.unwrap();
				} else {
					if is_node(x, x.parent.unwrap().left) {
						// Case 2
						x = x.parent.unwrap();
						self.right_rotate(x);
					}

					// Case 3
					x.parent.unwrap().color = Color::Black;
					x.parent.unwrap().parent.unwrap().color = Color::Red;
					self.left_rotate(x.parent.unwrap().parent.unwrap());
				}
			}
		}

		self.root.unwrap().color = Color::Black;
		None
	}

	fn remove(self, key) {
		let z = self.find_node(key);
		if z.is_none() {
			return None;
		}
		let z = z.unwrap();

		// Y is the node to be unlinked from the tree.
		let y = if z.left.is_none() || z.right.is_none() {
			z
		} else {
			z.successor().unwrap()
		};

		// Y is guaranteed to be non-null at this point.
		let x = if y.left.is_some() {
			y.left
		} else {
			y.right
		};

		// X is the child of y which might potentially replace y
		// in the tree. X might be null at this point.
		let x_parent = if let Some(x) = x {
			x.parent = y.parent;
			x.parent
		} else {
			y.parent
		};

		if let Some(parent) = y.parent {
			if is_node(y, parent.left) {
				parent.left = x;
			} else {
				parent.right = x;
			}
		} else {
			self.root = x;
		}

		if !y.same(z) {
			if y.color == Color::Black {
				self.remove_fixup(x, x_parent);
			}

			y.parent = z.parent;
			y.color = z.color;
			y.left = z.left;
			y.right = z.right;

			if let Some(left) = z.left {
				left.parent = Some(y);
			}
			if let Some(right) = z.right {
				right.parent = Some(y);
			}
			if let Some(parent) = z.parent {
				if is_node(z, parent.left) {
					parent.left = Some(y);
				} else {
					parent.right = Some(y);
				}
			} else {
				self.root = Some(y);
			}
		} else if y.color == Color::Black {
			self.remove_fixup(x, x_parent);
		}

		Some(z.value)
	}

	fn get(self, key) {
		if let Some(node) = self.find_node(key) {
			return Some(node.value);
		}
		None
	}

	fn for_each(self, f) {
		if self.root.is_none() {
			return;
		}
		let current = Some(tree_minimum(self.root.unwrap()));
		while let Some(node) = current {
			f(RbtEntry::new(node.key, node.value));
			current = node.successor();
		}
	}

	fn find_node(self, key) {
		let current = self.root;
		while let Some(node) = current {
			let comparison_result = key.compare_to(node.key);
			if comparison_result == 0 {
				return Some(node);
			} else if comparison_result < 0 {
				current = node.left;
			} else {
				current = node.right;
			}
		}
		None
	}

	fn tree_insert(self, key, value) {
		let y = None;
		let x = self.root;

		while let Some(node) = x {
			y = x;
			let comparison_result = key.compare_to(node.key);
			if comparison_result < 0 {
				x = node.left;
			} else if comparison_result > 0 {
				x = node.right;
			} else {
				let old_value = node.value;
				node.value = value;
				return InsertResult::new(false, None, Some(old_value));
			}
		}

		let z = Node::new(self.next_id, key, value);
		self.next_id = self.next_id + 1;
		z.parent = y;

		if let Some(y) = y {
			if key.compare_to(y.key) < 0 {
				y.left = Some(z);
			} else {
				y.right = Some(z);
			}
		} else {
			self.root = Some(z);
		}
		InsertResult::new(true, Some(z), None)
	}

	fn left_rotate(self, x) {
		let y = x.right.unwrap();

		// Turn y's left subtree into x's right subtree.
		x.right = y.left;
		if let Some(left) = y.left {
			left.parent = Some(x);
		}

		// Link x's parent to y.
		y.parent = x.parent;
		if let Some(parent) = x.parent {
			if is_node(x, parent.left) {
				parent.left = Some(y);
			} else {
				parent.right = Some(y);
			}
		} else {
			self.root = Some(y);
		}

		// Put x on y's left.
		y.left = Some(x);
		x.parent = Some(y);

		y
	}

	fn right_rotate(self, y) {
		let x = y.left.unwrap();

		// Turn x's right subtree into y's left subtree.
		y.left = x.right;
		if let Some(right) = x.right {
			right.parent = Some(y);
		}

		// Link y's parent to x.
		x.parent = y.parent;
		if let Some(parent) = y.parent {
			if is_node(y, parent.left) {
				parent.left = Some(x);
			} else {
				parent.right = Some(x);
			}
		} else {
			self.root = Some(x);
		}

		x.right = Some(y);
		y.parent = Some(x);

		x
	}

	fn remove_fixup(self, x, x_parent) {
		while !same_node(x, self.root) && (x.is_none() || x.unwrap().color == Color::Black) {
			let xp = x_parent.unwrap();
			if same_node(x, xp.left) {
				// Note: the text points out that w cannot be null.
				// The reason is not obvious from simply looking at the code;
				// it comes about from the properties of the red-black tree.
				let w = xp.right.unwrap();
				if w.color == Color::Red {
					// Case 1
					w.color = Color::Black;
					xp.color = Color::Red;
					self.left_rotate(xp);
					w = xp.right.unwrap();
				}
				if (w.left.is_none() || w.left.unwrap().color == Color::Black)
					&& (w.right.is_none() || w.right.unwrap().color == Color::Black)
				{
					// Case 2
					w.color = Color::Red;
					x = x_parent;
					x_parent = x.unwrap().parent;
				} else {
					if w.right.is_none() || w.right.unwrap().color == Color::Black {
						// Case 3
						w.left.unwrap().color = Color::Black;
						w.color = Color::Red;
						self.right_rotate(w);
						w = xp.right.unwrap();
					}
					// Case 4
					w.color = xp.color;
					xp.color = Color::Black;
					if let Some(right) = w.right {
						right.color = Color::Black;
					}
					self.left_rotate(xp);
					x = self.root;
					x_parent = x.unwrap().parent;
				}
			} else {
				// Same as "then" clause with "right" and "left" exchanged.
				let w = xp.left.unwrap();
				if w.color == Color::Red {
					// Case 1
					w.color = Color::Black;
					xp.color = Color::Red;
					self.right_rotate(xp);
					w = xp.left.unwrap();
				}
				if (w.right.is_none() || w.right.unwrap().color == Color::Black)
					&& (w.left.is_none() || w.left.unwrap().color == Color::Black)
				{
					// Case 2
					w.color = Color::Red;
					x = x_parent;
					x_parent = x.unwrap().parent;
				} else {
					if w.left.is_none() || w.left.unwrap().color == Color::Black {
						// Case 3
						w.right.unwrap().color = Color::Black;
						w.color = Color::Red;
						self.left_rotate(w);
						w = xp.left.unwrap();
					}
					// Case 4
					w.color = xp.color;
					xp.color = Color::Black;
					if let Some(left) = w.left {
						left.color = Color::Black;
					}
					self.right_rotate(xp);
					x = self.root;
					x_parent = x.unwrap().parent;
				}
			}
		}
		if let Some(x) = x {
			x.color = Color::Black;
		}
	}
}

struct CallSign {
	value,
}

impl CallSign {
	fn new(value) {
		CallSign { value }
	}

	fn compare_to(self, other) {
		if self.value == other.value {
			0
		} else if self.value < other.value {
			-1
		} else {
			1
		}
	}
}

struct Collision {
	aircraft_a,
	aircraft_b,
	position,
}

impl Collision {
	fn new(aircraft_a, aircraft_b, position) {
		Collision { aircraft_a, aircraft_b, position }
	}
}

struct Motion {
	callsign,
	pos_one,
	pos_two,
}

impl Motion {
	fn new(callsign, pos_one, pos_two) {
		Motion { callsign, pos_one, pos_two }
	}

	fn delta(self) {
		self.pos_two.minus(self.pos_one)
	}

	fn find_intersection(self, other) {
		let init1 = self.pos_one;
		let init2 = other.pos_one;
		let vec1 = self.delta();
		let vec2 = other.delta();
		let radius = PROXIMITY_RADIUS;

		// this test is not geometrical 3-d intersection test,
		// it takes the fact that the aircraft move
		// into account; so it is more like a 4d test
		// (it assumes that both of the aircraft have a constant speed
		// over the tested interval)

		// we thus have two points,
		// each of them moving on its line segment at constant speed;
		// we are looking for times when the distance between
		// these two points is smaller than r

		// vec1 is vector of aircraft 1
		// vec2 is vector of aircraft 2

		// a = (V2 - V1)^T * (V2 - V1)
		let a = vec2.minus(vec1).squared_magnitude();

		if a != 0.0 {
			// we are first looking for instances
			// of time when the planes are exactly r from each other
			// at least one plane is moving;
			// if the planes are moving in parallel, they do not have constant speed

			// if the planes are moving in parallel, then
			//   if the faster starts behind the slower,
			//     we can have 2, 1, or 0 solutions
			//   if the faster plane starts in front of the slower,
			//     we can have 0 or 1 solutions

			// if the planes are not moving in parallel, then

			// point P1 = I1 + vV1
			// point P2 = I2 + vV2
			//   - looking for v, such that dist(P1,P2) = || P1 - P2 || = r

			// it follows that || P1 - P2 || = sqrt( < P1-P2, P1-P2 > )
			//   0 = -r^2 + < P1 - P2, P1 - P2 >
			//  from properties of dot product
			//   0 = -r^2 + <I1-I2,I1-I2> + v * 2<I1-I2, V1-V2> + v^2 *<V1-V2,V1-V2>
			//   so we calculate a, b, c - and solve the quadratic equation
			//   0 = c + bv + av^2

			// b = 2 * <I1-I2, V1-V2>
			let b = 2.0 * init1.minus(init2).dot(vec1.minus(vec2));

			// c = -r^2 + (I2 - I1)^T * (I2 - I1)
			let c = -radius * radius + init2.minus(init1).squared_magnitude();

			let discr = b * b - 4.0 * a * c;
			if discr < 0.0 {
				return None;
			}

			let v1 = (-b - discr.sqrt()) / (2.0 * a);
			let v2 = (-b + discr.sqrt()) / (2.0 * a);

			if v1 <= v2 && ((v1 <= 1.0 && 1.0 <= v2) || (v1 <= 0.0 && 0.0 <= v2) || (0.0 <= v1 && v2 <= 1.0)) {
				// Pick a good "time" at which to report the collision.
				let v = if v1 <= 0.0 {
					// The collision started before this frame.
					// Report it at the start of the frame.
					0.0
				} else {
					// The collision started during this frame. Report it at that moment.
					v1
				};

				let result1 = init1.plus(vec1.times(v));
				let result2 = init2.plus(vec2.times(v));

				let result = result1.plus(result2).times(0.5);
				if result.x >= MIN_X
					&& result.x <= MAX_X
					&& result.y >= MIN_Y
					&& result.y <= MAX_Y
					&& result.z >= MIN_Z
					&& result.z <= MAX_Z
				{
					return Some(result);
				}
			}

			return None;
		}

		// the planes have the same speeds and are moving in parallel
		// (or they are not moving at all)
		// they  thus have the same distance all the time;
		// we calculate it from the initial point

		// dist = || i2 - i1 || = sqrt(  ( i2 - i1 )^T * ( i2 - i1 ) )
		let dist = init2.minus(init1).magnitude();
		if dist <= radius {
			return Some(init1.plus(init2).times(0.5));
		}
		None
	}
}

/// `horizontal` and `vertical` are Lua's module constants: Rune constants cannot hold
/// struct values.
struct CollisionDetector {
	state,
	horizontal,
	vertical,
}

impl CollisionDetector {
	fn new() {
		CollisionDetector {
			state: RedBlackTree::new(),
			horizontal: Vector2D::new(GOOD_VOXEL_SIZE, 0.0),
			vertical: Vector2D::new(0.0, GOOD_VOXEL_SIZE),
		}
	}

	fn handle_new_frame(self, frame) {
		let motions = Vector::new();
		let seen = RedBlackTree::new();

		frame.each(|aircraft| {
			let old_position = self.state.put(aircraft.callsign, aircraft.position);
			let new_position = aircraft.position;
			seen.put(aircraft.callsign, true);

			let old_position = if let Some(old_position) = old_position {
				old_position
			} else {
				// Treat newly introduced aircraft as if they were stationary.
				new_position
			};

			motions.append(Motion::new(aircraft.callsign, old_position, new_position));
		});

		// Remove aircraft that are no longer present.
		let to_remove = Vector::new();
		self.state.for_each(|e| {
			if seen.get(e.key).is_none() {
				to_remove.append(e.key);
			}
		});

		to_remove.each(|e| {
			self.state.remove(e);
		});

		let all_reduced = self.reduce_collision_set(motions);
		let collisions = Vector::new();
		all_reduced.each(|reduced| {
			for i in 0..reduced.size() {
				let motion1 = reduced.at(i);
				for j in i + 1..reduced.size() {
					let motion2 = reduced.at(j);
					let collision = motion1.find_intersection(motion2);
					if let Some(collision) = collision {
						collisions.append(Collision::new(motion1.callsign, motion2.callsign, collision));
					}
				}
			}
		});

		collisions
	}

	fn is_in_voxel(self, voxel, motion) {
		if voxel.x > MAX_X || voxel.x < MIN_X || voxel.y > MAX_Y || voxel.y < MIN_Y {
			return false;
		}

		let init = motion.pos_one;
		let fin = motion.pos_two;

		let v_s = GOOD_VOXEL_SIZE;
		let r = PROXIMITY_RADIUS / 2.0;

		let v_x = voxel.x;
		let x0 = init.x;
		let xv = fin.x - init.x;

		let v_y = voxel.y;
		let y0 = init.y;
		let yv = fin.y - init.y;

		let low_x = (v_x - r - x0) / xv;
		let high_x = (v_x + v_s + r - x0) / xv;

		if xv < 0.0 {
			let tmp = low_x;
			low_x = high_x;
			high_x = tmp;
		}

		let low_y = (v_y - r - y0) / yv;
		let high_y = (v_y + v_s + r - y0) / yv;

		if yv < 0.0 {
			let tmp = low_y;
			low_y = high_y;
			high_y = tmp;
		}

		((xv == 0.0 && v_x <= x0 + r && x0 - r <= v_x + v_s) // no motion in x
			|| (low_x <= 1.0 && 1.0 <= high_x)
			|| (low_x <= 0.0 && 0.0 <= high_x)
			|| (0.0 <= low_x && high_x <= 1.0))
			&& ((yv == 0.0 && v_y <= y0 + r && y0 - r <= v_y + v_s) // no motion in y
				|| ((low_y <= 1.0 && 1.0 <= high_y)
					|| (low_y <= 0.0 && 0.0 <= high_y)
					|| (0.0 <= low_y && high_y <= 1.0)))
			&& (xv == 0.0 || yv == 0.0 // no motion in x or y or both
				|| (low_y <= high_x && high_x <= high_y)
				|| (low_y <= low_x && low_x <= high_y)
				|| (low_x <= low_y && high_y <= high_x))
	}

	fn put_into_map(self, voxel_map, voxel, motion) {
		let array = voxel_map.get(voxel);
		let array = if let Some(array) = array {
			array
		} else {
			let array = Vector::new();
			voxel_map.put(voxel, array);
			array
		};
		array.append(motion);
	}

	fn recurse(self, voxel_map, seen, next_voxel, motion) {
		if !self.is_in_voxel(next_voxel, motion) {
			return;
		}
		if seen.put(next_voxel, true).is_some() {
			return;
		}

		self.put_into_map(voxel_map, next_voxel, motion);

		self.recurse(voxel_map, seen, next_voxel.minus(self.horizontal), motion);
		self.recurse(voxel_map, seen, next_voxel.plus(self.horizontal), motion);
		self.recurse(voxel_map, seen, next_voxel.minus(self.vertical), motion);
		self.recurse(voxel_map, seen, next_voxel.plus(self.vertical), motion);
		self.recurse(voxel_map, seen, next_voxel.minus(self.horizontal).minus(self.vertical), motion);
		self.recurse(voxel_map, seen, next_voxel.minus(self.horizontal).plus(self.vertical), motion);
		self.recurse(voxel_map, seen, next_voxel.plus(self.horizontal).minus(self.vertical), motion);
		self.recurse(voxel_map, seen, next_voxel.plus(self.horizontal).plus(self.vertical), motion);
	}

	fn reduce_collision_set(self, motions) {
		let voxel_map = RedBlackTree::new();
		motions.each(|motion| {
			self.draw_motion_on_voxel_map(voxel_map, motion);
		});

		let result = Vector::new();
		voxel_map.for_each(|e| {
			if e.value.size() > 1 {
				result.append(e.value);
			}
		});
		result
	}

	fn voxel_hash(self, position) {
		let x_div = (position.x / GOOD_VOXEL_SIZE).floor();
		let y_div = (position.y / GOOD_VOXEL_SIZE).floor();

		let x = GOOD_VOXEL_SIZE * x_div;
		let y = GOOD_VOXEL_SIZE * y_div;

		if position.x < 0.0 {
			x = x - GOOD_VOXEL_SIZE;
		}
		if position.y < 0.0 {
			y = y - GOOD_VOXEL_SIZE;
		}

		Vector2D::new(x, y)
	}

	fn draw_motion_on_voxel_map(self, voxel_map, motion) {
		let seen = RedBlackTree::new();
		self.recurse(voxel_map, seen, self.voxel_hash(motion.pos_one), motion)
	}
}

struct Aircraft {
	callsign,
	position,
}

impl Aircraft {
	fn new(callsign, position) {
		Aircraft { callsign, position }
	}
}

struct Simulator {
	aircraft,
}

impl Simulator {
	fn new(num_aircrafts) {
		let aircraft = Vector::new();
		for i in 0..num_aircrafts {
			aircraft.append(CallSign::new(i + 1));
		}
		Simulator { aircraft }
	}

	fn simulate(self, time) {
		let frame = Vector::new();
		let i = 0;
		while i < self.aircraft.size() - 1 {
			frame.append(Aircraft::new(self.aircraft.at(i), Vector3D::new(time, time.cos() * 2.0 + ((i * 3) as f64), 10.0)));
			frame.append(Aircraft::new(self.aircraft.at(i + 1), Vector3D::new(time, time.sin() * 2.0 + ((i * 3) as f64), 10.0)));
			i = i + 2;
		}
		frame
	}
}

struct CD;

impl CD {
	fn benchmark(self, num_aircrafts) {
		let num_frames = 200;
		let simulator = Simulator::new(num_aircrafts);
		let detector = CollisionDetector::new();

		let actual_collisions = 0;
		for i in 0..num_frames {
			let time = (i as f64) / 10.0;
			let collisions = detector.handle_new_frame(simulator.simulate(time));
			actual_collisions = actual_collisions + collisions.size();
		}
		actual_collisions
	}

	fn inner_benchmark_loop(self, inner_iterations) {
		self.verify_result(self.benchmark(inner_iterations), inner_iterations)
	}

	fn verify_result(self, actual_collisions, num_aircrafts) {
		if num_aircrafts == 1000 {
			actual_collisions == 14484
		} else if num_aircrafts == 500 {
			actual_collisions == 14484
		} else if num_aircrafts == 250 {
			actual_collisions == 10830
		} else if num_aircrafts == 200 {
			actual_collisions == 8655
		} else if num_aircrafts == 100 {
			actual_collisions == 4305
		} else if num_aircrafts == 10 {
			actual_collisions == 390
		} else if num_aircrafts == 2 {
			actual_collisions == 42
		} else {
			println!("No verification result for {} found", num_aircrafts);
			println!("Result is: {}", actual_collisions);
			false
		}
	}
}

fn new_benchmark() {
	CD
}
