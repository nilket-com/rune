// Port of AWFY benchmarks/Lua/json.lua and hashindextable-53.lua.

const NAME = "Json";

/// Rune has no inheritance: each JsonValue kind repeats the JsonValue defaults it
/// does not override.
struct JsonArray {
	values,
}

impl JsonArray {
	fn new() {
		JsonArray { values: Vector::new() }
	}

	fn add(self, value) {
		self.values.append(value);
		self
	}

	fn size(self) {
		self.values.size()
	}

	fn get(self, index) {
		self.values.at(index)
	}

	fn is_object(self) {
		false
	}

	fn is_array(self) {
		true
	}

	fn is_number(self) {
		false
	}

	fn is_string(self) {
		false
	}

	fn is_boolean(self) {
		false
	}

	fn is_true(self) {
		false
	}

	fn is_false(self) {
		false
	}

	fn is_null(self) {
		false
	}

	fn as_object(self) {
		panic!("Unsupported operation, not an object: {}", self.as_string());
	}

	fn as_array(self) {
		self
	}
}

struct JsonLiteral {
	value,
	is_null,
	is_true,
	is_false,
}

impl JsonLiteral {
	fn new(value) {
		JsonLiteral {
			value,
			is_null: "null" == value,
			is_true: "true" == value,
			is_false: "false" == value,
		}
	}

	fn as_string(self) {
		self.value
	}

	fn is_boolean(self) {
		self.is_true || self.is_false
	}

	fn is_object(self) {
		false
	}

	fn is_array(self) {
		false
	}

	fn is_number(self) {
		false
	}

	fn is_string(self) {
		false
	}

	fn is_true(self) {
		self.is_true
	}

	fn is_false(self) {
		self.is_false
	}

	fn is_null(self) {
		self.is_null
	}

	fn as_object(self) {
		panic!("Unsupported operation, not an object: {}", self.as_string());
	}

	fn as_array(self) {
		panic!("Unsupported operation, not an array: {}", self.as_string());
	}
}

