impl Json {
	fn inner_benchmark_loop(self, inner_iterations) {
		default_inner_benchmark_loop(self, inner_iterations)
	}

	fn benchmark(self) {
		Parser::new(RAP_BENCHMARK_MINIFIED).parse()
	}

	fn verify_result(self, result) {
		if !result.is_object() {
			return false;
		}
		if !result.as_object().get("head").unwrap().is_object() {
