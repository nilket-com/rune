      "after": [
        "",
        "#[test]",
        "#[cfg(not(miri))]",
        "fn d1d_numeric_context_slice_both_engines() {",
        "\tuse crate::runtime::{VmError, VmErrorKind};",
        "\tlet context = Context::with_default_modules().unwrap();",
        "\tlet rows = [",
        "\t\t(\"!a\", \"\\\"x\\\"\", \"0\", \"Cannot apply `!` to `String`\"),",
        "\t\t(\"a & b\", \"7\", \"true\", \"Cannot apply `&` to `i64` and `bool`\"),",
        "\t\t(\"a | b\", \"7\", \"true\", \"Cannot apply `|` to `i64` and `bool`\"),",
        "\t\t(\"a ^ b\", \"7\", \"true\", \"Cannot apply `^` to `i64` and `bool`\"),",
        "\t\t(",
        "\t\t\t\"a << b\",",
        "\t\t\t\"7\",",
        "\t\t\t\"true\",",
        "\t\t\t\"Cannot apply `<<` to `i64` and `bool`\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a >> b\",",
        "\t\t\t\"7\",",
        "\t\t\t\"true\",",
        "\t\t\t\"Cannot apply `>>` to `i64` and `bool`\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a << b\",",
        "\t\t\t\"1\",",
        "\t\t\t\"-1\",",
        "\t\t\t\"Cannot convert `i64` value `-1` to `u32` for `<<`\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a >> b\",",
        "\t\t\t\"1\",",
        "\t\t\t\"-1\",",
        "\t\t\t\"Cannot convert `i64` value `-1` to `u32` for `>>`\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a << b\",",
        "\t\t\t\"1\",",
        "\t\t\t\"64\",",
        "\t\t\t\"Numerical overflow in `i64` left shift (`<<`)\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a << b\",",
        "\t\t\t\"1\",",
        "\t\t\t\"65\",",
        "\t\t\t\"Numerical overflow in `i64` left shift (`<<`)\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a >> b\",",
        "\t\t\t\"1\",",
        "\t\t\t\"64\",",
        "\t\t\t\"Numerical underflow in `i64` right shift (`>>`)\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a >> b\",",
        "\t\t\t\"1\",",
        "\t\t\t\"65\",",
        "\t\t\t\"Numerical underflow in `i64` right shift (`>>`)\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a / b\",",
        "\t\t\t\"1\",",
        "\t\t\t\"0\",",
        "\t\t\t\"Division by zero in `i64` division (`/`)\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a % b\",",
        "\t\t\t\"1\",",
        "\t\t\t\"0\",",
        "\t\t\t\"Division by zero in `i64` remainder (`%`)\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a + b\",",
        "\t\t\t\"9223372036854775807\",",
        "\t\t\t\"1\",",
        "\t\t\t\"Numerical overflow in `i64` addition (`+`)\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a - b\",",
        "\t\t\t\"-9223372036854775808\",",
        "\t\t\t\"1\",",
        "\t\t\t\"Numerical underflow in `i64` subtraction (`-`)\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a + b\",",
        "\t\t\t\"18446744073709551615u64\",",
        "\t\t\t\"1u64\",",
        "\t\t\t\"Numerical overflow in `u64` addition (`+`)\",",
        "\t\t),",
        "\t\t(",
        "\t\t\t\"a - b\",",
        "\t\t\t\"0u64\",",
        "\t\t\t\"1u64\",",
        "\t\t\t\"Numerical underflow in `u64` subtraction (`-`)\",",
        "\t\t),",
        "\t];",
        "\tfor (body, a, b, expected) in rows {",
        "\t\tlet source = std::format!(\"fn f(a,b){{{body}}}pub fn main(){{f({a},{b})}}\");",
        "\t\tlet (mut stock, program) = compile(&context, &source);",
        "\t\tlet error = stock.call([\"main\"], ()).unwrap_err();",
        "\t\tassert_eq!(error.to_string(), expected, \"stock {source}\");",
        "\t\tlet mut store = Store::new(Limits::default()).unwrap();",
        "\t\tlet mut executor = Executor::new().unwrap();",
        "\t\tlet failure = executor",
        "\t\t\t.invoke(",
        "\t\t\t\t&program,",
        "\t\t\t\t&mut store,",
        "\t\t\t\tprogram.function(Hash::type_hash([\"main\"])).unwrap(),",
        "\t\t\t\t&[],",
        "\t\t\t\t100_000,",
        "\t\t\t)",
        "\t\t\t.unwrap_err();",
        "\t\tassert_eq!(",
        "\t\t\tfailure.message(&program).to_string(),",
        "\t\t\texpected,",
        "\t\t\t\"fresh {source}\"",
        "\t\t);",
        "\t\tassert!(matches!(",
        "\t\t\tfailure.error.kind,",
        "\t\t\tErrorKind::Type",
        "\t\t\t\t| ErrorKind::Overflow",
        "\t\t\t\t| ErrorKind::DivisionByZero",
        "\t\t\t\t| ErrorKind::IntegerCoercion",
        "\t\t));",
        "\t\tassert_eq!(store.live_entries(), 0);",
        "\t}",
        "\tfor (kind, expected) in [",
        "\t\t(VmErrorKind::Overflow, \"Numerical overflow\"),",
        "\t\t(VmErrorKind::Underflow, \"Numerical underflow\"),",
        "\t\t(VmErrorKind::DivideByZero, \"Division by zero\"),",
        "\t] {",
        "\t\tassert_eq!(VmError::from(kind).to_string(), expected);",
        "\t}",
        "\tlet (_, program) = compile(&context, \"pub fn main(){0}\");",
        "\tfor (kind, expected) in [",
        "\t\t(ErrorKind::Overflow, \"Numerical overflow\"),",
        "\t\t(ErrorKind::DivisionByZero, \"Division by zero\"),",
        "\t] {",
        "\t\tlet error = crate::experimental_core::error::Error::new(kind, \"native helper\");",
        "\t\tassert_eq!(error.message(&program).to_string(), expected);",
        "\t}",
        "}"
      ]
    },
