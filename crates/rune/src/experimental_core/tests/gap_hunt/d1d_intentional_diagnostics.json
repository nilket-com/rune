        "impl crate::runtime::messages::OperandType for TypeName {",
        "\tfn fmt_operand(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {",
        "\t\tlet name = match self {",
        "\t\t\tSelf::I64 => \"i64\",",
